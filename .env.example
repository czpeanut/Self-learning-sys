# Gemini API 金鑰（AI 出題、AI 詳解都需要；沒填時只有數學計算型知識點能出題，且沒有 AI 詳解）
GEMINI_API_KEY=
# 出題用模型（預設 gemini-2.5-flash）
GEMINI_MODEL=gemini-2.5-flash
# AI 詳解（問 AI）用模型，預設與 student-app 相同：gemini-3.7-flash
GEMINI_SOLVE_MODEL=gemini-3.7-flash
# 整站通行碼（選用）：設了之後每台裝置要先輸入一次，擋館外的人使用、保護 AI 額度
SITE_ACCESS_CODE=
# OLE-QS 匯出檔位置（選填；沒設會找 ../OLE-QS/data/export，再沒有就從 GitHub 下載）
OLEQS_EXPORT=
