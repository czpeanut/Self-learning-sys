# Gemini API 金鑰（AI 出題、AI 詳解都需要；沒填時只有數學計算型知識點能出題，且沒有 AI 詳解）
GEMINI_API_KEY=
# 出題用模型（預設 gemini-2.5-flash）
GEMINI_MODEL=gemini-2.5-flash
# AI 詳解（問 AI）用模型，預設與 student-app 相同：gemini-3.7-flash
GEMINI_SOLVE_MODEL=gemini-3.7-flash
# 整站通行碼（選用）：設了之後每台裝置要先輸入一次，擋館外的人使用、保護 AI 額度
SITE_ACCESS_CODE=
# OLE-QS 匯出檔位置（選填；沒設會找 ../OLE-QS/data/export，再沒有就從 GitHub 下載）
OLEQS_EXPORT=
# ── 雲端帳號與紀錄（選用，見 docs/AUTH.md）：四個都設了才啟用；沒設就用裝置帳號 ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只在伺服器使用（建立學生帳號等），絕對不能外流
SUPABASE_SERVICE_ROLE_KEY=
# 館方管理員的 Google email（逗號分隔），可進 /admin 管理學生帳號
NEXT_PUBLIC_ADMIN_EMAILS=
